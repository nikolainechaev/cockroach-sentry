[Unit]
Description=Cockroach Sentry - PIR-triggered insect detection daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/cockroach-sentry
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/cockroach-sentry/vision_to_db.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
